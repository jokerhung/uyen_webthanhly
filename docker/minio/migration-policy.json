{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InventoryTargetBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::besties-media"]
    },
    {
      "Sid": "CopyAndVerifyProductObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::besties-media/*"]
    }
  ]
}
