# Web server port for npm run dev and npm run start (default: 3000).
PORT=3000
# Local development only; do not expose DATABASE_URL in NEXT_PUBLIC_ variables.
DATABASE_URL="postgresql://webkygui:dev_only_change_me@127.0.0.1:5432/webkygui_dev?schema=public"
# Shop phone, address, name, colors, social link and hours are stored in shop_settings, not .env.
# Opt in to search indexing ONLY on verified HTTPS production host. Preview/dev remain noindex.
SITE_URL=""
# Comma-separated trusted public HTTPS origins for admin requests behind a reverse proxy.
ADMIN_ALLOWED_ORIGINS=""
PUBLIC_INDEXING_ENABLED="false"
MIN_CONSIGNMENT_ITEMS=""
MAX_IMAGES_PER_ITEM=""
MAX_IMAGE_BYTES=""
MAX_CONSIGNMENT_ITEMS=""
# Enable submissions only after shop reviews the personal-data notice and retention policy.
PRIVACY_POLICY_REVIEWED="false"
# Private persistent volume, never inside public/; default .private/consignments for dev.
CONSIGNMENT_STORAGE_DIR=""

# Product images stay local until migration and verification are completed.
PRODUCT_IMAGE_STORAGE_DRIVER="local"
# REQUIRED for minio service: audited patched build pinned as registry/name@sha256:<64 hex>.
# No image was verified at authoring time; deliberately no default or floating tag.
# MINIO_IMAGE=
# Set distinct, strong root credentials in untracked .env or a secret manager.
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# Server-only app credentials provisioned by docker/minio/bootstrap.sh, NOT root credentials.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="besties-media"
S3_FORCE_PATH_STYLE="true"
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Separate migration credentials are provisioned offline; never reuse app/root credentials.
